OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ===== DEFAULT LLM MODEL =====
# This model is used by default for citation filtering, pre-filtering, and other LLM tasks
# Format "provider/model" → OpenRouter (e.g., google/gemini-2.5-flash, openai/gpt-4)
# Format "model" → OpenAI direct (e.g., gpt-4o-mini, gpt-4o)
# Examples:
#   - google/gemini-2.5-flash (OpenRouter - economical)
#   - openai/gpt-4o (OpenRouter - via OpenRouter proxy)
#   - gpt-4o-mini (OpenAI direct)
OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash-preview
PINECONE_API_KEY=pcsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PINECONE_ENV=https://your-index-name.svc.region.pinecone.io
WEAVIATE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WEAVIATE_URL=https://your-cluster.weaviate.cloud
QDRANT_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
QDRANT_URL=https://your-cluster.qdrant.io
MISTRAL_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai
# Large-file handling (Mistral /v1/files rejects uploads above ~50 MB).
# When a PDF exceeds MISTRAL_MAX_UPLOAD_MB, RAGpy first recompresses it via
# PyMuPDF; if it still does not fit, it splits it into parts of
# MISTRAL_SPLIT_PART_MB and OCRs each part separately.
MISTRAL_MAX_UPLOAD_MB=45
MISTRAL_AUTO_COMPRESS=true
MISTRAL_AUTO_SPLIT=true
MISTRAL_SPLIT_PART_MB=45
# Mistral OCR also rejects documents > 1000 pages (HTTP 400 code 3730).
# We split below this threshold; each part targets MISTRAL_SPLIT_PART_PAGES pages.
MISTRAL_MAX_PAGES=950
MISTRAL_SPLIT_PART_PAGES=500
# Lot 1 — retry transient Mistral failures (404 "Could not get file", 429, 5xx,
# network timeouts) before falling back to a degraded provider. A 401 is never
# retried (key refused OR monthly spend cap reached → check console.mistral.ai).
# Backoff is exponential (BACKOFF * 2**attempt) capped at MAX_BACKOFF, with
# jitter; a 429 `Retry-After` header overrides the computed wait.
MISTRAL_OCR_RETRIES=4
MISTRAL_OCR_RETRY_BACKOFF=3.0
MISTRAL_OCR_RETRY_MAX_BACKOFF=60.0
# Provider policy — OpenAI Vision OCR is OFF by default: it is hard-capped at
# OPENAI_OCR_MAX_PAGES and silently truncates books. Chain = Mistral → legacy.
# Set to 1 to re-enable the opt-in OpenAI branch (with the partial guards).
OCR_ENABLE_OPENAI_FALLBACK=0
# Lot 4 — OCR LOCAL (Docling) : voie sans clé/cap/réseau, insérée AVANT legacy.
# Isolée dans un subprocess (scripts/ocr_local.py) ; auto-désactivée si le moteur
# n'est pas installé.
# PROTOCOLE D'INSTALL (simple) : mettre INSTALL_LOCAL_OCR=true ci-dessous puis
#   docker compose up -d --build        # installe Docling dans l'image
INSTALL_LOCAL_OCR=false           # build-time: installe Docling dans un venv dédié /opt/ocr-venv
OCR_ENABLE_LOCAL_FALLBACK=1       # runtime: active la voie locale dans la chaîne
# LOCAL_OCR_PYTHON=               # interpréteur du subprocess OCR (défaut: /opt/ocr-venv/bin/python)
LOCAL_OCR_ENGINE=docling          # docling | mineru | marker (seul docling implémenté)
LOCAL_OCR_DEVICE=cpu              # cpu | cuda
LOCAL_OCR_MAX_PAGES=0             # 0 = aucun cap
LOCAL_OCR_TIMEOUT=1800            # secondes, par document
LOCAL_OCR_CONCURRENCY=1           # CPU/RAM-bound → garder bas (1-2)
LOCAL_OCR_THREADS=0               # threads torch/layout (0 = auto = min(cpu, 8))
LOCAL_OCR_TABLES=0               # 1 = activer la détection de tableaux (TableFormer, +lent)
# Lot 2 — anti-truncation guard. Below this average char/page an OCR result is
# flagged `partial` (texteocr_partial column + errors.json) instead of being
# returned as a silent success (e.g. a scanned book through the legacy engine).
OCR_MIN_CHARS_PER_PAGE=500
# Tip: keep PDF_EXTRACTION_WORKERS aligned with MISTRAL_CONCURRENT_CALLS — more
# PDF workers than Mistral slots just queues threads on the semaphore and
# increases the chance of clustered 429s. Lower both if you hit the rate limit.
ZOTERO_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
ZOTERO_USER_ID=12345
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=noreply@example.com
APP_URL=http://localhost:8000

# ===== UVICORN CONFIGURATION =====
# Workers: nombre de processus (recommandé: 1 par CPU core)
UVICORN_WORKERS=7
# Keep-alive timeout en secondes (pour processus longs)
UVICORN_TIMEOUT_KEEP_ALIVE=120
# Max requêtes simultanées par worker
UVICORN_LIMIT_CONCURRENCY=100

# ===== CONCURRENCY CONTROL =====
# Script workers (CPU-bound tasks)
DEFAULT_MAX_WORKERS=8           # ThreadPoolExecutor global
DEFAULT_DOC_WORKERS=6           # Documents en parallèle (chunking)
PDF_EXTRACTION_WORKERS=4        # PDFs en parallèle (OCR)

# API batching (rate limits)
DEFAULT_BATCH_SIZE_GPT=5        # Chunks/batch recodage GPT
DEFAULT_EMBEDDING_BATCH_SIZE=32 # Chunks/batch embeddings OpenAI

# LLM concurrency (global limit across all users)
MAX_CONCURRENT_LLM_CALLS=6      # Max appels LLM simultanés

# Citation processing (PoP import parallel batches)
MAX_CONCURRENT_WEB_FETCHES=10   # Web fetches parallèles par batch
DEFAULT_CITATION_BATCH_SIZE=10  # Citations par batch (1-50)

# Vector DB upsert
PINECONE_BATCH_SIZE=100
WEAVIATE_BATCH_SIZE=100
QDRANT_BATCH_SIZE=100

# Session management
MAX_ACTIVE_SESSIONS=50          # Limite sessions simultanées
SESSION_TTL_HOURS=24            # Auto-cleanup après 24h

# ===== USER REGISTRATION =====
# Sandbox mode: when TRUE, new users are blocked until admin approval
USERS_SANDBOX=TRUE

# ===== CELERY CONFIGURATION (Phase 3 - Production) =====
# Enable Celery task queue (set to 'true' for production)
ENABLE_CELERY=false

# Redis broker configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== DÉDUPLICATION DES CHUNKS (anti-doublons RAG) =====
# Master switch. 0 (défaut) = comportement STRICTEMENT identique à avant : aucun
# content_hash écrit dans le JSON, id aléatoire conservé, dedup_filter no-op.
DEDUP_ENABLED=0
# Tier 3 sémantique (similarité d'embedding sur les survivants Tier 2). OFF par
# défaut ; réservé aux petits lots ré-OCR multi-fournisseurs (near-dups).
DEDUP_SEMANTIC=0
DEDUP_SIM_THRESHOLD=0.97          # Seuil Tier 3, métrique-aware (méta+Jaccard portent la décision)
DEDUP_TEXT_JACCARD=0.92           # Jaccard word-3-gram minimal (Tier 3)
DEDUP_META_FIELDS=title           # Champs devant concorder avant un refus (ex: "title,authors")
DEDUP_MIN_CHARS=64                # Plancher texte normalisé ; en deçà → inéligible (jamais matché)
DEDUP_QUERY_BATCH=100             # Taille du lot d'existence (1 RTT / lot, pas N)
DEDUP_MATCH_MAX=3                 # Max de témoins existants listés par refus
DEDUP_SEMANTIC_MAX_SURVIVORS=500  # Garde dure : au-delà, Tier 3 sauté (0 requête vectorielle)
# DEDUP_JOURNAL_DIR=              # Override dossier journal (défaut : à côté du JSON d'embeddings)

# ===== RECODAGE DÉTERMINISTE (cache + durcissement) =====
# Cache de recodage SQLite clé par content_hash : HIT → 0 appel LLM, texte stocké
# byte-identique entre runs. 0 (défaut) = byte-identique à avant.
RECODE_CACHE_ENABLED=0
RECODE_HARDEN_ENABLED=0           # Durcissement décodage (temp0/top_p1/seed/snapshot daté), découplé du cache
RECODE_EMBED_CACHE_ENABLED=0      # Cache de vecteurs denses (texte identique → vecteur gelé)
RECODE_MODEL=gpt-4o-mini-2024-07-18   # Snapshot daté (dans la clé de cache)
RECODE_PREFER_OPENAI=1            # 1 = OpenAI direct (seed honoré) ; 0 = OpenRouter (pin backend requis pour cacher)
RECODE_TEMPERATURE=0.0
RECODE_TOP_P=1.0
RECODE_SEED=0
RECODE_MAX_TOKENS=1600            # Borné ; sûr seulement avec la garde finish_reason (fallback_truncated)
# RECODE_OPENROUTER_PROVIDER=     # Pin backend OpenRouter (allow_fallbacks=False) ; obligatoire pour cacher ce chemin
RECODE_CACHE_PATH=data/recode_cache.sqlite

# Flower monitoring credentials
FLOWER_USER=admin
FLOWER_PASSWORD=changeme