OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ===== DEFAULT LLM MODEL =====
# This model is used by default for citation filtering, pre-filtering, and other LLM tasks
# Format "provider/model" → OpenRouter (e.g., google/gemini-2.5-flash, openai/gpt-4)
# Format "model" → OpenAI direct (e.g., gpt-4o-mini, gpt-4o)
# Examples:
#   - google/gemini-2.5-flash (OpenRouter - economical)
#   - openai/gpt-4o (OpenRouter - via OpenRouter proxy)
#   - gpt-4o-mini (OpenAI direct)
OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash-preview
PINECONE_API_KEY=pcsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PINECONE_ENV=https://your-index-name.svc.region.pinecone.io
WEAVIATE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WEAVIATE_URL=https://your-cluster.weaviate.cloud
QDRANT_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
QDRANT_URL=https://your-cluster.qdrant.io
MISTRAL_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai
# Large-file handling (Mistral /v1/files rejects uploads above ~50 MB).
# When a PDF exceeds MISTRAL_MAX_UPLOAD_MB, RAGpy first recompresses it via
# PyMuPDF; if it still does not fit, it splits it into parts of
# MISTRAL_SPLIT_PART_MB and OCRs each part separately.
MISTRAL_MAX_UPLOAD_MB=45
MISTRAL_AUTO_COMPRESS=true
MISTRAL_AUTO_SPLIT=true
MISTRAL_SPLIT_PART_MB=45
# Mistral OCR also rejects documents > 1000 pages (HTTP 400 code 3730).
# We split below this threshold; each part targets MISTRAL_SPLIT_PART_PAGES pages.
MISTRAL_MAX_PAGES=950
MISTRAL_SPLIT_PART_PAGES=500
# Lot 1 — retry transient Mistral failures (404 "Could not get file", 429, 5xx,
# network timeouts) before falling back to a degraded provider. A 401 is never
# retried (key refused OR monthly spend cap reached → check console.mistral.ai).
# Backoff is exponential (BACKOFF * 2**attempt) capped at MAX_BACKOFF, with
# jitter; a 429 `Retry-After` header overrides the computed wait.
MISTRAL_OCR_RETRIES=4
MISTRAL_OCR_RETRY_BACKOFF=3.0
MISTRAL_OCR_RETRY_MAX_BACKOFF=60.0
# Provider policy — OpenAI Vision OCR is OFF by default: it is hard-capped at
# OPENAI_OCR_MAX_PAGES and silently truncates books. Chain = Mistral → legacy.
# Set to 1 to re-enable the opt-in OpenAI branch (with the partial guards).
OCR_ENABLE_OPENAI_FALLBACK=0
# Lot 4 — OCR LOCAL (Docling) : voie sans clé/cap/réseau, insérée AVANT legacy.
# Isolée dans un subprocess (scripts/ocr_local.py) ; auto-désactivée si le moteur
# n'est pas installé.
# PROTOCOLE D'INSTALL (simple) : mettre INSTALL_LOCAL_OCR=true ci-dessous puis
#   docker compose up -d --build        # installe Docling dans l'image
INSTALL_LOCAL_OCR=false           # build-time: installe Docling dans un venv dédié /opt/ocr-venv
OCR_ENABLE_LOCAL_FALLBACK=1       # runtime: active la voie locale dans la chaîne
# LOCAL_OCR_PYTHON=               # interpréteur du subprocess OCR (défaut: /opt/ocr-venv/bin/python)
LOCAL_OCR_ENGINE=docling          # docling | mineru | marker (seul docling implémenté)
LOCAL_OCR_DEVICE=cpu              # cpu | cuda
LOCAL_OCR_MAX_PAGES=0             # 0 = aucun cap
LOCAL_OCR_TIMEOUT=1800            # secondes, par document
LOCAL_OCR_CONCURRENCY=1           # CPU/RAM-bound → garder bas (1-2)
LOCAL_OCR_THREADS=0               # threads torch/layout (0 = auto = min(cpu, 8))
LOCAL_OCR_TABLES=0               # 1 = activer la détection de tableaux (TableFormer, +lent)
# Lot 2 — anti-truncation guard. Below this average char/page an OCR result is
# flagged `partial` (texteocr_partial column + errors.json) instead of being
# returned as a silent success (e.g. a scanned book through the legacy engine).
OCR_MIN_CHARS_PER_PAGE=500
# Tip: keep PDF_EXTRACTION_WORKERS aligned with MISTRAL_CONCURRENT_CALLS — more
# PDF workers than Mistral slots just queues threads on the semaphore and
# increases the chance of clustered 429s. Lower both if you hit the rate limit.
ZOTERO_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
ZOTERO_USER_ID=12345
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=noreply@example.com
APP_URL=http://localhost:8000

# ===== UVICORN CONFIGURATION =====
# Workers: nombre de processus (recommandé: 1 par CPU core)
UVICORN_WORKERS=7
# Keep-alive timeout en secondes (pour processus longs)
UVICORN_TIMEOUT_KEEP_ALIVE=120
# Max requêtes simultanées par worker
UVICORN_LIMIT_CONCURRENCY=100

# ===== CONCURRENCY CONTROL =====
# Script workers (CPU-bound tasks)
DEFAULT_MAX_WORKERS=8           # ThreadPoolExecutor global
DEFAULT_DOC_WORKERS=6           # Documents en parallèle (chunking)
PDF_EXTRACTION_WORKERS=4        # PDFs en parallèle (OCR)

# API batching (rate limits)
DEFAULT_BATCH_SIZE_GPT=5        # Chunks/batch recodage GPT
DEFAULT_EMBEDDING_BATCH_SIZE=32 # Chunks/batch embeddings OpenAI

# LLM concurrency (global limit across all users)
MAX_CONCURRENT_LLM_CALLS=6      # Max appels LLM simultanés

# Citation processing (PoP import parallel batches)
MAX_CONCURRENT_WEB_FETCHES=10   # Web fetches parallèles par batch
DEFAULT_CITATION_BATCH_SIZE=10  # Citations par batch (1-50)

# Vector DB upsert
PINECONE_BATCH_SIZE=100
WEAVIATE_BATCH_SIZE=100
QDRANT_BATCH_SIZE=100

# Session management
MAX_ACTIVE_SESSIONS=50          # Limite sessions simultanées
SESSION_TTL_HOURS=24            # Auto-cleanup après 24h

# Admission des traitements (audit A12) : traitements actifs sur le serveur et
# par utilisateur (429 au-delà ; 0 = sans limite). Un traitement du même groupe
# sur une session déjà occupée est refusé (409). Verrous partagés entre processus
# et conteneurs dans RAGPY_LOCK_DIR (défaut data/locks).
MAX_ACTIVE_JOBS=8
MAX_ACTIVE_JOBS_PER_USER=3
RAGPY_LOCK_DIR=

# Fiabilité du pipeline (audit A07/A10)
# Part d'embeddings OpenAI manquants tolérée avant l'échec de la phase dense (0 à 1).
EMBED_MAX_MISSING_RATIO=0
# Délai minimal (s) entre deux écritures du fichier de chunks pendant un lot.
CHUNK_CHECKPOINT_SECONDS=30
# Lots d'embeddings en vol par worker (fenêtre bornée).
EMBEDDING_FUTURES_PER_WORKER=4

# ===== USER REGISTRATION =====
# Sandbox mode: when TRUE, new users are blocked until admin approval
USERS_SANDBOX=TRUE

# ===== SÉCURITÉ DU DÉPLOIEMENT (audit A09) =====
# production = démarrage refusé si JWT_SECRET_KEY est absent, vaut la valeur de
# remplacement du dépôt ou fait moins de 32 caractères (development : alerte seule).
RAGPY_ENV=development
# Secret JWT, défini une fois : il dérive aussi la clé Fernet des identifiants
# stockés. Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Rotation : l'ancien secret ici le temps de rechiffrer (scripts/rotate_credentials_key.py),
# puis vider. Sans lui, changer JWT_SECRET_KEY rend illisibles les clés enregistrées.
JWT_SECRET_KEY_PREVIOUS=
# Origines cross-origin autorisées (avec cookies) ; les pages sont servies par l'application.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Limites des imports (Mo ; 0 = pas de limite) : fichier envoyé, archive ZIP
# décompressée, nombre de membres d'une archive. Aligner client_max_body_size (nginx).
UPLOAD_MAX_MB=4096
UPLOAD_MAX_UNZIPPED_MB=16384
UPLOAD_MAX_ZIP_ENTRIES=100000
# Exposition des ports Redis et Flower sur l'hôte (docker-compose) : 127.0.0.1 par défaut.
REDIS_BIND=127.0.0.1
FLOWER_BIND=127.0.0.1

# ===== CELERY CONFIGURATION (Phase 3 - Production) =====
# Enable Celery task queue (set to 'true' for production)
ENABLE_CELERY=false

# Redis broker configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== DÉDUPLICATION DES CHUNKS (anti-doublons RAG) =====
# Master switch. 0 (défaut) = comportement STRICTEMENT identique à avant : aucun
# content_hash écrit dans le JSON, id aléatoire conservé, dedup_filter no-op.
DEDUP_ENABLED=0
# Tier 3 sémantique (similarité d'embedding sur les survivants Tier 2). OFF par
# défaut ; réservé aux petits lots ré-OCR multi-fournisseurs (near-dups).
DEDUP_SEMANTIC=0
DEDUP_SIM_THRESHOLD=0.97          # Seuil Tier 3, métrique-aware (méta+Jaccard portent la décision)
DEDUP_TEXT_JACCARD=0.92           # Jaccard word-3-gram minimal (Tier 3)
# Champs qui identifient la SOURCE d'un chunk (id v2 = contenu + source, audit A05) et doivent
# concorder avant un refus. Titres génériques (« Introduction ») : ajouter authors ou itemKey,
# sinon deux œuvres homonymes au passage identique partagent un id. Un champ vide = jamais dédupliqué.
DEDUP_META_FIELDS=title           # Champs devant concorder avant un refus (ex: "title,authors")
DEDUP_MIN_CHARS=64                # Plancher texte normalisé ; en deçà → inéligible (jamais matché)
DEDUP_QUERY_BATCH=100             # Taille du lot d'existence (1 RTT / lot, pas N)
DEDUP_MATCH_MAX=3                 # Max de témoins existants listés par refus
DEDUP_SEMANTIC_MAX_SURVIVORS=500  # Garde dure : au-delà, Tier 3 sauté (0 requête vectorielle)
# DEDUP_JOURNAL_DIR=              # Override dossier journal (défaut : à côté du JSON d'embeddings)

# ===== RECODAGE DÉTERMINISTE (cache + durcissement) =====
# Cache de recodage SQLite clé par content_hash : HIT → 0 appel LLM, texte stocké
# byte-identique entre runs. 0 (défaut) = byte-identique à avant.
RECODE_CACHE_ENABLED=0
RECODE_HARDEN_ENABLED=0           # Durcissement décodage (temp0/top_p1/seed/snapshot daté), découplé du cache
RECODE_EMBED_CACHE_ENABLED=0      # Cache de vecteurs denses (texte identique → vecteur gelé)
RECODE_MODEL=gpt-4o-mini-2024-07-18   # Snapshot daté (dans la clé de cache)
RECODE_PREFER_OPENAI=1            # 1 = OpenAI direct (seed honoré) ; 0 = OpenRouter (pin backend requis pour cacher)
RECODE_TEMPERATURE=0.0
RECODE_TOP_P=1.0
RECODE_SEED=0
RECODE_MAX_TOKENS=1600            # Borné ; sûr seulement avec la garde finish_reason (fallback_truncated)
# RECODE_OPENROUTER_PROVIDER=     # Pin backend OpenRouter (allow_fallbacks=False) ; obligatoire pour cacher ce chemin
RECODE_CACHE_PATH=data/recode_cache.sqlite

# ===== ALBERT API (DINUM) — OPT-IN, OFF PAR DÉFAUT =====
# Inférence souveraine servie par la DINUM : chat, OCR, embeddings bge-m3 et
# collections. Guide complet : .claude/docs/albert.md. Tant que ALBERT_ENABLED=0,
# les variables de ce bloc sont sans effet, sauf deux : EMBEDDING_PROVIDER=albert
# est refusé (phase dense en exit 2, champ du formulaire en 400) et
# DEDUP_SIM_THRESHOLD_BGE_M3 s'applique au Tier 3 de tout fichier bge-m3, Albert
# activé ou non.
# Interrupteur maître. 0 (défaut) = comportement strictement identique : ni appel,
# ni route, ni interface, ni clé JSON Albert.
ALBERT_ENABLED=0
# Clé Bearer du compte Albert (identifiant albert_api_key). Repli .env réservé aux
# admins ; un non-admin saisit sa propre clé dans Paramètres > Mes Identifiants.
# Jamais renvoyée en clair (masquée par le serveur).
ALBERT_API_KEY=
# URL de base, configuration serveur uniquement : https, /v1 garanti, hôte en
# liste blanche ; vide = défaut.
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
# 1 = autorise un OpenGateLLM auto-hébergé hors liste blanche (https reste imposé).
ALBERT_ALLOW_CUSTOM_HOST=0

# --- OCR Albert (maillon placé avant Mistral) ---
# 1 = OCR Albert en tête de chaîne (exige ALBERT_ENABLED=1 et une clé).
# 0 (défaut) = chaîne OCR strictement identique.
OCR_ENABLE_ALBERT=0
# auto = /v1/ocr si le compte y a accès, sinon LightOnOCR ; chat = LightOnOCR
# seul ; ocr = /v1/ocr seul.
ALBERT_OCR_MODE=auto
# Modèles épinglés : OCR par chat sur pages rastérisées, puis /v1/ocr (accès
# restreint).
ALBERT_OCR_CHAT_MODEL=lightonocr-2-1b
ALBERT_OCR_DOC_MODEL=mistral-ocr-2512
# Rastérisation et requête LightOnOCR : résolution, plus grand côté (pixels),
# max_tokens, température, top_p.
ALBERT_OCR_DPI=200
ALBERT_OCR_MAX_SIDE=1540
ALBERT_OCR_MAX_TOKENS=4096
ALBERT_OCR_TEMPERATURE=0.2
ALBERT_OCR_TOP_P=0.9
# Plafond de pages par document (0 = aucun ; au-delà, résultat partiel).
ALBERT_OCR_MAX_PAGES=0
# Part de pages en échec au-delà de laquelle le maillon Albert est abandonné.
ALBERT_OCR_MAX_FAILED_RATIO=0.5
# Découpage des envois à /v1/ocr : taille (Mo) et nombre de pages par part.
ALBERT_OCR_PART_MB=15
ALBERT_OCR_PART_PAGES=100
# Requêtes OCR Albert simultanées par processus.
ALBERT_OCR_CONCURRENCY=1
# 1 = texte albert_lightonocr exclu du recodage. 0 (défaut prudent) = recodé.
ALBERT_OCR_SKIP_RECODE=0

# --- Embeddings ---
# openai (défaut : text-embedding-3-large, 3072 d) ou albert (bge-m3, 1024 d,
# exige ALBERT_ENABLED=1). Deux espaces séparés, jamais dans le même index.
EMBEDDING_PROVIDER=openai
# Modèle d'embeddings Albert (id épinglé, jamais de repli).
ALBERT_EMBED_MODEL=bge-m3
# Textes par requête d'embeddings (plafonné à 64).
ALBERT_EMBED_BATCH=64
# Part d'embeddings manquants tolérée avant l'échec de la phase (0.0 = aucun manque).
ALBERT_EMBED_MAX_MISSING_RATIO=0.0
# 1 = vecteurs normalisés L2 (norme enregistrée dans l'espace vectoriel).
ALBERT_EMBED_L2_NORMALIZE=1

# --- Chat : raisonnement et repli de modèle ---
# Effort de raisonnement des modèles gpt-oss (low, medium, high).
ALBERT_REASONING_EFFORT=medium
# Tokens ajoutés à max_tokens pour le raisonnement des modèles gpt-oss.
ALBERT_REASONING_HEADROOM=2048
# 1 = repli sur le modèle suivant du rôle après des 503 répétés (jamais sur 404,
# jamais pour les embeddings).
ALBERT_MODEL_FALLBACK=1
# Essais courts sur 503 avant le repli de rôle.
ALBERT_BUSY_RETRIES=2

# --- Quotas (partagés par compte Albert) et concurrence ---
# Limiteur proactif, environ 90 % des quotas du régime d'expérimentation : requêtes
# par minute des rôles recodage, notes, OCR et embeddings, puis tokens d'entrée
# estimés par minute pour les rôles de chat.
ALBERT_RECODE_RPM=45
ALBERT_NOTES_RPM=9
ALBERT_OCR_RPM=45
ALBERT_EMBED_RPM=450
ALBERT_CHAT_TPM=115000
# Part des quotas attribuée à ce processus (0 < part <= 1).
ALBERT_PROCESS_SHARE=1.0
# local = limiteur par processus ; redis = partagé (recommandé avec Celery ou
# plusieurs sessions).
ALBERT_LIMITER_BACKEND=local
# URL Redis du limiteur ; vide = CELERY_BROKER_URL, sinon redis://localhost:6379/0.
ALBERT_LIMITER_REDIS_URL=
# Appels Albert simultanés par processus : recodage, notes et fiches, embeddings,
# envois de chunks vers une collection.
ALBERT_RECODE_CONCURRENCY=2
ALBERT_NOTES_CONCURRENCY=2
ALBERT_EMBED_CONCURRENCY=4
ALBERT_PUSH_CONCURRENCY=1

# --- Réessais et délais ---
# Réessais au plus sur erreur transitoire ; backoff exponentiel (base et plafond,
# en secondes).
ALBERT_MAX_RETRIES=4
ALBERT_RETRY_BACKOFF=2.0
ALBERT_RETRY_MAX_BACKOFF=60
# Retry-After (secondes) au-delà duquel un 429 signifie un quota épuisé (abandon).
ALBERT_RETRY_AFTER_MAX=120
# Délais HTTP (secondes) : chat, notes et fiches, page OCR, part /v1/ocr,
# embeddings, collections.
ALBERT_TIMEOUT_CHAT=120
ALBERT_TIMEOUT_NOTES=300
ALBERT_TIMEOUT_OCR_PAGE=120
ALBERT_TIMEOUT_OCR_DOC=300
ALBERT_TIMEOUT_EMBED=60
ALBERT_TIMEOUT_COLLECTIONS=120
# Délai (secondes) des sous-processus quand la requête sélectionne Albert (6 h) ;
# sinon, délais historiques inchangés.
ALBERT_SUBPROCESS_TIMEOUT=21600

# --- Collections, dédup et traçabilité ---
# Métadonnées envoyées aux collections : 10 au plus, avec content_id, content_hash,
# chunk_index et DEDUP_META_FIELDS ; jamais path.
ALBERT_METADATA_FIELDS=content_id,content_hash,chunk_index,total_chunks,title,authors,year,doi,item_key,filename
# Seuil Tier 3 de la dédup pour bge-m3 ; vide (défaut) = Tier 3 sauté pour bge-m3.
DEDUP_SIM_THRESHOLD_BGE_M3=
# 1 = ledger albert_usage.jsonl écrit quand Albert a été appelé.
ALBERT_USAGE_LOG=1
# 1 = contrôle du compte et des modèles (/v1/me, /v1/models) avant un traitement.
ALBERT_PREFLIGHT=1
# Estimation des tokens d'entrée du limiteur (chars = longueur / 3 ; ou tiktoken).
ALBERT_TOKEN_ESTIMATOR=chars

# Flower monitoring credentials
# Obligatoires : Flower refuse de démarrer sans identifiants ou avec admin/admin,
# admin/changeme (audit A09).
FLOWER_USER=
FLOWER_PASSWORD=
# Âge (s) au-delà duquel un script du worker est tué comme orphelin ; vide =
# plus grande limite de temps d'une tâche (Albert compris) + 600 s.
ORPHAN_PROCESS_MAX_RUNTIME=