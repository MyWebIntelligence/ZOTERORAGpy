# =============================================================================
# RAGpy — modèle de configuration
# =============================================================================
# Copier en .env à la racine du dépôt : cp .env.example .env
#
# Fichier GÉNÉRÉ par « python scripts/env_tool.py example » à partir du registre
# scripts/rad_settings/registry.py : ne pas l'éditer à la main (modifier le
# registre, puis régénérer). Même ordre et mêmes blocs que le .env rangé par
# « python scripts/env_tool.py tidy --apply ».
#
# Qui lit le .env :
#   - l'application web (app/config.py, load_dotenv) ;
#   - les scripts du pipeline (scripts/rad_env.load_dotenv_guarded) ;
#   - Docker Compose : env_file des 4 services (ragpy, celery_worker,
#     celery_beat, flower) ET interpolation des ${…} de docker-compose.yml.
#   Exception : scripts/rad_vectordb.py en ligne de commande ne charge pas le
#   .env (exporter les variables dans le shell).
#
# Conventions :
#   - La valeur écrite est le défaut du code, sauf si le commentaire indique
#     « défaut : … ». Supprimer une ligne redonne le défaut du code ; une ligne
#     laissée vide ne le fait que si le commentaire le précise.
#   - « # NOM=valeur » : variable facultative, non déclarée ; décommenter la
#     ligne pour l'utiliser.
#   - Serveurs d'API (bloc 1) : OpenRouter et Mistral préremplis, les autres en
#     commentaire. Adresses vérifiées, documentation et modèles réputés :
#     README.md, section « Serveurs d'API et modèles ». Les adresses des
#     nouveaux serveurs et les couples serveur + modèle par service (bloc 2)
#     sont lus à partir du lot 4 du sprint « configuration unifiée ».
#   - Clés API : le .env sert de repli aux seuls administrateurs. Un utilisateur
#     non-admin n'y a jamais accès et saisit ses clés dans
#     Paramètres > Mes Identifiants (chiffrées en base avec JWT_SECRET_KEY).
#   - Docker : le code est intégré à l'image (rebuild après mise à jour du
#     code) ; le .env est relu à la recréation des conteneurs
#     (docker compose up -d). INSTALL_LOCAL_OCR, lu à la construction, exige
#     docker compose up -d --build.
#
# Minimum pour démarrer : décommenter OPENAI_API_KEY (embeddings OpenAI par
# défaut) et, en production, le bloc 9 (RAGPY_ENV, JWT_SECRET_KEY, CORS).

# ===== 1. SERVEURS D'API ET SERVICES EXTERNES : ADRESSES ET CLÉS =====
# Un service (bloc 2) désigne son serveur par son ADRESSE ; la clé envoyée est celle
# du sous-bloc dont l'adresse correspond (une adresse non déclarée ici est refusée).
# Adresses vérifiées et modèles réputés : README.md, section « Serveurs d'API et modèles ».

# --- 1.1 OpenRouter ---
# Adresse de l'API OpenRouter.
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# Alternative économique (~75 % moins chère pour le recodage).
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- 1.2 Mistral ---
# Adresse de l'API Mistral (OCR et modèles de langage), avec ou sans /v1.
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1
# OCR Mistral, premier maillon de la chaîne OCR par défaut. Un 401 peut signifier le
# plafond de dépense mensuel atteint (console.mistral.ai → Limits), pas seulement
# une clé invalide.
MISTRAL_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- 1.3 OpenAI ---
# Adresse de l'API OpenAI.
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# Embeddings text-embedding-3-large (3072 d) et modèles OpenAI (recodage, notes).
# Nécessaire tant que les embeddings restent sur OpenAI.
# OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- 1.4 Albert (DINUM) ---
# URL de base, configuration serveur uniquement : https, /v1 garanti, hôte en
# liste blanche ; vide = défaut.
# ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
# Clé Bearer du compte Albert (identifiant albert_api_key). Repli .env réservé aux
# admins ; un non-admin saisit sa propre clé dans Paramètres > Mes Identifiants.
# Jamais renvoyée en clair (masquée par le serveur).
# ALBERT_API_KEY=
# 1 = autorise un OpenGateLLM auto-hébergé hors liste blanche (https reste imposé).
# ALBERT_ALLOW_CUSTOM_HOST=0

# --- 1.5 Anthropic ---
# Couche de compatibilité OpenAI d'Anthropic (selon Anthropic, pas une solution de
# production à long terme).
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
# Clé du serveur ci-dessus (identifiant anthropic_api_key). Repli .env réservé aux admins ;
# un non-admin saisit sa propre clé dans Mon profil > Clés API (visible quand l'adresse est déclarée).
# ANTHROPIC_API_KEY=

# --- 1.6 Google Gemini ---
# Compatibilité OpenAI de l'API Gemini.
# GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Clé du serveur ci-dessus (identifiant google_api_key). Repli .env réservé aux admins ;
# un non-admin saisit sa propre clé dans Mon profil > Clés API (visible quand l'adresse est déclarée).
# GOOGLE_API_KEY=

# --- 1.7 DeepSeek ---
# API DeepSeek, compatible OpenAI, sans /v1.
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Clé du serveur ci-dessus (identifiant deepseek_api_key). Repli .env réservé aux admins ;
# un non-admin saisit sa propre clé dans Mon profil > Clés API (visible quand l'adresse est déclarée).
# DEEPSEEK_API_KEY=

# --- 1.8 Qwen (Alibaba Cloud) ---
# Qwen, Alibaba Cloud Model Studio, mode compatible OpenAI : adresse propre à chaque
# espace de travail (Singapour ; États-Unis : https://dashscope-us.aliyuncs.com/compatible-mode/v1).
# QWEN_API_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Clé du serveur ci-dessus (identifiant qwen_api_key). Repli .env réservé aux admins ;
# un non-admin saisit sa propre clé dans Mon profil > Clés API (visible quand l'adresse est déclarée).
# QWEN_API_KEY=

# --- 1.9 GLM (Z.ai) ---
# GLM (Z.ai, international), compatible OpenAI ; Chine : https://open.bigmodel.cn/api/paas/v4.
# GLM_API_BASE_URL=https://api.z.ai/api/paas/v4
# Clé du serveur ci-dessus (identifiant glm_api_key). Repli .env réservé aux admins ;
# un non-admin saisit sa propre clé dans Mon profil > Clés API (visible quand l'adresse est déclarée).
# GLM_API_KEY=

# --- 1.10 Serveur local compatible OpenAI (Ollama, vLLM, LM Studio) ---
# Serveur local compatible OpenAI : Ollama http://localhost:11434/v1, vLLM
# http://localhost:8000/v1, LM Studio http://localhost:1234/v1.
# LOCAL_API_BASE_URL=http://localhost:11434/v1
# Clé du serveur local, s'il en exige une (Ollama : n'importe quelle valeur).
# LOCAL_API_KEY=

# --- 1.11 Pinecone ---
# Les index et collections doivent exister (pas de création automatique Pinecone) :
# 3072 dimensions pour OpenAI, 1024 pour bge-m3 (Albert).
PINECONE_API_KEY=pcsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Facultatif : le client Pinecone v5 résout l'index par son nom ; champ conservé
# pour le formulaire des identifiants.
PINECONE_ENV=

# --- 1.12 Weaviate ---
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- 1.13 Qdrant ---
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- 1.14 Zotero ---
# Clé : https://www.zotero.org/settings/keys/new (accès bibliothèque + notes,
# écriture pour pousser fiches et tags).
ZOTERO_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
# Bibliothèque personnelle (identifiant numérique affiché sur la page des clés).
ZOTERO_USER_ID=12345
# Bibliothèque de groupe, si les items y sont (sinon laisser vide).
ZOTERO_GROUP_ID=

# --- 1.15 Resend (e-mails) ---
# Vérification des adresses et réinitialisation des mots de passe (Resend).
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Défaut : onboarding@resend.dev (adresse de test de Resend).
RESEND_FROM_EMAIL=noreply@example.com

# ===== 2. SERVEURS ET MODÈLES PAR SERVICE =====
# Chaque service déclare un couple SERVEUR (adresse d'un serveur du bloc 1) + MODÈLE
# (envoyé tel quel au serveur) ; vide = valeur par défaut (2.1), sauf pour l'OCR qui
# n'a pas de défaut. Embeddings, rerank et audio : lot 6.

# --- 2.1 Par défaut ---
# Serveur par défaut des services de langage : adresse d'un serveur du bloc 1.
# Vide = mode historique (OPENROUTER_DEFAULT_MODEL, recodage gpt-4o-mini).
LLM_DEFAULT_SERVER=https://openrouter.ai/api/v1
# Modèle par défaut, envoyé tel quel au serveur retenu (nom du modèle chez ce serveur).
LLM_DEFAULT_MODEL=google/gemini-3.8-flash
# Historique : lu seulement si LLM_DEFAULT_SERVER est vide. Modèle par défaut des
# notes, fiches et citations (provider/model → OpenRouter, nom nu → OpenAI,
# albert/<id> → Albert). Défaut : gpt-4o-mini.
# OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash-preview

# --- 2.2 Recodage des chunks (étape 3.1) ---
# Serveur du recodage des chunks ; vide = LLM_DEFAULT_SERVER.
LLM_RECODE_SERVER=
# Modèle du recodage ; vide = LLM_DEFAULT_MODEL. Envoyé tel quel au serveur retenu.
LLM_RECODE_MODEL=openai/gpt-4o-mini
# Historique : snapshot daté qui remplace le modèle du recodage en mode durci,
# seulement si LLM_DEFAULT_SERVER est vide (sinon LLM_RECODE_MODEL fait foi).
# RECODE_MODEL=gpt-4o-mini-2024-07-18
# Historique (mode durci, LLM_DEFAULT_SERVER vide) : 1 = OpenAI direct (seed
# honoré) ; 0 = OpenRouter (épinglage du backend requis pour cacher ce chemin).
# RECODE_PREFER_OPENAI=1

# --- 2.3 Notes Zotero (fiche et résumé) ---
# Serveur des notes Zotero (fiche, résumé) ; vide = LLM_DEFAULT_SERVER.
LLM_NOTES_SERVER=
# Modèle des notes ; vide = LLM_DEFAULT_MODEL.
LLM_NOTES_MODEL=

# --- 2.4 Fiches de lecture (structure, chapitres, synthèse) ---
# Serveur des fiches de lecture (structure, chapitres, synthèse) ; vide =
# LLM_DEFAULT_SERVER.
LLM_BOOK_SERVER=
# Modèle des fiches de lecture ; vide = LLM_DEFAULT_MODEL.
LLM_BOOK_MODEL=

# --- 2.5 Filtre et pré-filtre des citations ---
# Serveur du filtre et du pré-filtre des citations ; vide = LLM_DEFAULT_SERVER.
LLM_CITATIONS_SERVER=
# Modèle des citations ; vide = LLM_DEFAULT_MODEL.
LLM_CITATIONS_MODEL=

# --- 2.6 OCR ---
# Serveur de l'OCR : adresse de Mistral, d'Albert ou du serveur local (bloc 1), ou le mot
# réservé local pour les moteurs internes. Un seul moteur, aucun repli : il doit
# répondre au contrôle préalable, sinon rien ne démarre. OCR_MODEL vide = chaîne
# historique (Albert si OCR_ENABLE_ALBERT=1, Mistral, Docling, PyMuPDF).
OCR_SERVER=https://api.mistral.ai/v1
# Modèle d'OCR, envoyé tel quel : mistral-ocr-latest (Mistral), lightonocr-2-1b ou
# mistral-ocr-2512 (Albert ; /v1/ocr pour un modèle de type image-to-text, page par
# page sinon), docling ou pymupdf (couche texte native, sans Tesseract) avec local.
OCR_MODEL=mistral-ocr-latest
# Repli de l'OCR : adresse d'un AUTRE serveur du bloc 1 (ou local). Vides tous les deux :
# aucun repli, un échec du moteur principal fait échouer le document.
OCR_SERVER_FALLBACK=
# Modèle de repli, envoyé tel quel. Rempli : un document dont l'OCR principal échoue est
# repris par ce moteur ; après une erreur de compte (clé, plafond, quota), la suite du lot
# passe par lui. Repli tracé (OCR_PROVIDER_FALLBACK) ; colonnes texteocr_server/model du
# moteur qui a servi. Contrôlé avant le premier document, comme le moteur principal.
OCR_MODEL_FALLBACK=
# Historique (OCR_MODEL vide) : modèle OCR de Mistral.
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# Historique (OCR_MODEL vide) : 1 = OCR Albert en tête de chaîne (exige ALBERT_ENABLED=1 et
# une clé) ; 0 (défaut) = chaîne OCR strictement identique.
# OCR_ENABLE_ALBERT=0
# Historique (OCR_MODEL vide) : auto = /v1/ocr si le compte y a accès, sinon
# LightOnOCR ; chat = LightOnOCR seul ; ocr = /v1/ocr seul.
# ALBERT_OCR_MODE=auto
# Historique (OCR_MODEL vide) : modèle OCR par chat sur pages rastérisées (id épinglé).
# ALBERT_OCR_CHAT_MODEL=lightonocr-2-1b
# Historique (OCR_MODEL vide) : modèle de /v1/ocr, accès restreint (id épinglé).
# ALBERT_OCR_DOC_MODEL=mistral-ocr-2512
# Historique (OCR_MODEL vide) : OCR OpenAI Vision, plafonné à OPENAI_OCR_MAX_PAGES,
# il tronque les livres. Remplacé par OCR_SERVER_FALLBACK + OCR_MODEL_FALLBACK.
# OCR_ENABLE_OPENAI_FALLBACK=0
# Historique (OCR_MODEL vide) : modèle de l'OCR OpenAI Vision.
# OPENAI_OCR_MODEL=gpt-4o-mini
# Historique (OCR_MODEL vide) : 1 = OCR local Docling avant le dernier recours PyMuPDF
# (sauté sans erreur si Docling n'est pas installé).
# OCR_ENABLE_LOCAL_FALLBACK=1
# Historique (OCR_MODEL vide) : moteur de mise en page de l'OCR local (docling seul
# implémenté). Avec OCR_MODEL : OCR_SERVER=local et OCR_MODEL=docling.
# LOCAL_OCR_ENGINE=docling

# --- 2.7 Embeddings ---
# Serveur des embeddings : adresse d'OpenAI, d'Albert ou d'un serveur compatible
# (Mistral, Google, Qwen, OpenRouter, serveur local) du bloc 1 ; vide = LLM_DEFAULT_SERVER.
# Couple vide : règle historique (EMBEDDING_PROVIDER).
EMBEDDING_SERVER=
# Modèle d'embeddings, envoyé tel quel ; un modèle déclaré active le couple :
# text-embedding-3-large (OpenAI, 3072 d), bge-m3 (Albert, 1024 d), mistral-embed…
# Autres serveurs : dimension mesurée au premier appel. Un index n'accepte qu'un
# espace (modèle et dimension) : changer de modèle exige un autre index.
EMBEDDING_MODEL=
# Historique (EMBEDDING_MODEL vide) : openai (défaut : text-embedding-3-large, 3072 d)
# ou albert (bge-m3, 1024 d, exige ALBERT_ENABLED=1). Deux espaces séparés.
# EMBEDDING_PROVIDER=openai
# Historique (EMBEDDING_MODEL vide) : modèle d'embeddings Albert (id épinglé).
# ALBERT_EMBED_MODEL=bge-m3

# --- 2.8 Transcription audio ---
# Serveur de la transcription : adresse d'Albert seulement (bloc 1).
AUDIO_SERVER=
# Modèle de transcription, envoyé tel quel (whisper-large-v3) ; un modèle déclaré
# active l'import d'enregistrements (mp3, wav ; autres formats convertis par ffmpeg),
# puis pipeline habituel (recodage sauté). Vide : règle historique.
AUDIO_MODEL=
# Historique (AUDIO_MODEL vide) : 1 = import d'enregistrements transcrits par Whisper.
# ALBERT_AUDIO_ENABLED=0
# Historique (AUDIO_MODEL vide) : modèle de transcription Albert.
# ALBERT_AUDIO_MODEL=whisper-large-v3

# --- 2.9 Interrupteur Albert, politique et repli des modèles ---
# Interrupteur maître des services Albert (DINUM) : chat, OCR, embeddings bge-m3,
# collections. 0 (défaut) = comportement strictement identique : ni appel, ni route,
# ni interface, ni clé JSON Albert. Albert désactivé, deux réglages s'appliquent
# quand même : EMBEDDING_PROVIDER=albert est refusé (phase dense en exit 2, champ du
# formulaire en 400) et DEDUP_SIM_THRESHOLD_BGE_M3 s'applique au Tier 3 de tout
# fichier bge-m3. Guide complet : docs/albert.md.
ALBERT_ENABLED=0
# compatible (défaut) = fournisseurs historiques conservés à côté d'Albert ;
# albert_only = inférence Albert et traitements locaux seulement (OpenAI,
# OpenRouter et Mistral direct refusés, modèle vide = défaut Albert du rôle).
# albert_only avec ALBERT_ENABLED=0 : refus explicite, jamais de retour silencieux.
ALBERT_DATA_POLICY=compatible
# 1 = repli sur le modèle suivant du rôle après des 503 répétés (jamais sur 404,
# jamais pour les embeddings).
ALBERT_MODEL_FALLBACK=1

# ===== 3. OCR : RÉGLAGES PAR MOTEUR =====

# --- 3.1 Commun ---
# PDF OCRisés en parallèle (défaut : 1 = séquentiel) ; aligner sur
# MISTRAL_CONCURRENT_CALLS.
PDF_EXTRACTION_WORKERS=3
# Garde-fou anti-troncature : en dessous de cette moyenne de caractères par page,
# un résultat OpenAI ou legacy est marqué partiel (colonne texteocr_partial,
# OCR_PARTIAL dans *_errors.json) au lieu d'un succès silencieux.
OCR_MIN_CHARS_PER_PAGE=500

# --- 3.2 Mistral ---
# Appels OCR Mistral simultanés par processus (sémaphore). Aligner
# PDF_EXTRACTION_WORKERS sur cette valeur : plus de workers que de créneaux
# ne fait qu'attendre et multiplie les 429.
MISTRAL_CONCURRENT_CALLS=3
# Délai (s) d'une requête HTTP d'OCR Mistral.
MISTRAL_OCR_TIMEOUT=300
# 1 = supprime le fichier téléversé chez Mistral une fois l'OCR terminé.
MISTRAL_DELETE_UPLOADED_FILE=1
# Gros fichiers : /v1/files refuse ~50 Mo et l'OCR refuse plus de 1000 pages
# (code 3730). Au-delà de MISTRAL_MAX_UPLOAD_MB, le PDF est recompressé
# (PyMuPDF) ; s'il reste trop gros, ou au-delà de MISTRAL_MAX_PAGES, il est
# découpé en parts de MISTRAL_SPLIT_PART_MB et MISTRAL_SPLIT_PART_PAGES
# (les deux critères), OCRisées une à une puis recollées avec une
# numérotation de pages globale.
MISTRAL_MAX_UPLOAD_MB=45
MISTRAL_AUTO_COMPRESS=true
MISTRAL_AUTO_SPLIT=true
MISTRAL_SPLIT_PART_MB=30
MISTRAL_MAX_PAGES=950
MISTRAL_SPLIT_PART_PAGES=500
# Réessais des erreurs transitoires (404 « Could not get file », 408, 429,
# 5xx, coupure réseau) avant de passer au maillon suivant. Un 401 n'est
# jamais réessayé. Backoff exponentiel (BACKOFF * 2**tentative) plafonné à
# MAX_BACKOFF, avec gigue ; l'en-tête Retry-After d'un 429 est respecté.
MISTRAL_OCR_RETRIES=4
MISTRAL_OCR_RETRY_BACKOFF=3.0
MISTRAL_OCR_RETRY_MAX_BACKOFF=60.0
# 429 (limite de débit) : échelle plus longue (10, 20, 40, 80 s, plafond
# 120 s) et pause commune à tous les threads du processus, y compris après
# la dernière tentative (la part ou le document suivant attend aussi).
MISTRAL_OCR_RATE_LIMIT_BACKOFF=10.0
MISTRAL_OCR_RATE_LIMIT_MAX_BACKOFF=120.0
# Livre découpé : une part épuisée sur un 429 est reprise après les autres
# (RETRY_PASSES passes supplémentaires, chacune après RETRY_DELAY s ; 0 =
# aucune reprise). Au-delà de MAX_RATE_LIMITED_PARTS parts consécutives en
# 429, la passe n'envoie plus rien (quota épuisé) et remet le reste à la
# passe suivante (0 = jamais). Une part encore en échec laisse un marqueur
# « OCR ÉCHOUÉ » et le document est signalé partiel (cause : 429).
MISTRAL_SPLIT_RETRY_PASSES=1
MISTRAL_SPLIT_RETRY_DELAY=60.0
MISTRAL_SPLIT_MAX_RATE_LIMITED_PARTS=2

# --- 3.3 Albert ---
# Rastérisation et requête LightOnOCR : résolution, plus grand côté (pixels),
# max_tokens, température, top_p.
ALBERT_OCR_DPI=200
ALBERT_OCR_MAX_SIDE=1540
ALBERT_OCR_MAX_TOKENS=4096
ALBERT_OCR_TEMPERATURE=0.2
ALBERT_OCR_TOP_P=0.9
# Plafond de pages par document (0 = aucun ; au-delà, résultat partiel).
ALBERT_OCR_MAX_PAGES=0
# Part de pages en échec au-delà de laquelle le maillon Albert est abandonné.
ALBERT_OCR_MAX_FAILED_RATIO=0.5
# Découpage des envois à /v1/ocr : taille (Mo) et nombre de pages par part.
ALBERT_OCR_PART_MB=15
ALBERT_OCR_PART_PAGES=100
# Requêtes OCR Albert simultanées par processus.
ALBERT_OCR_CONCURRENCY=1
# 1 = texte albert_lightonocr exclu du recodage. 0 (défaut prudent) = recodé.
ALBERT_OCR_SKIP_RECODE=0
# 1 = reprise page par page de l'OCR LightOnOCR (pages validées gardées dans le
# dossier de sortie de la session, jamais renvoyées à Albert lors d'une relance).
ALBERT_OCR_CHECKPOINT=1

# --- 3.4 Local (Docling) ---
# Interpréteur du sous-processus OCR (défaut : /opt/ocr-venv/bin/python).
# LOCAL_OCR_PYTHON=
# Moteur de reconnaissance de Docling : tesseract (FR/EN, hors ligne) ou
# rapidocr (onnxruntime et modèles à installer à part ; plus lent sur CPU ARM).
LOCAL_OCR_ENGINE_OCR=tesseract
# 1 = classifieur d'orientation de RapidOCR (inutile sur des scans droits).
LOCAL_OCR_USE_CLS=0
# cpu | cuda
LOCAL_OCR_DEVICE=cpu
# Pages par document (0 = aucun plafond).
LOCAL_OCR_MAX_PAGES=0
# Délai (s) par document.
LOCAL_OCR_TIMEOUT=1800
# Documents OCRisés en parallèle (CPU et RAM : garder 1 ou 2).
LOCAL_OCR_CONCURRENCY=1
# Threads torch et mise en page (0 = min(nombre de CPU, 8)).
LOCAL_OCR_THREADS=0
# 1 = détection des tableaux (TableFormer, nettement plus lent).
LOCAL_OCR_TABLES=0
# Échelle de rendu des pages (1.0 ≈ 72 DPI ; 0 = défaut de Docling).
LOCAL_OCR_IMAGE_SCALE=0

# --- 3.5 OpenAI Vision (désactivé, retiré au lot 5) ---
# Réglages de l'OCR OpenAI Vision, utilisés seulement avec OCR_ENABLE_OPENAI_FALLBACK=1.
# OPENAI_OCR_MAX_PAGES=10
# OPENAI_OCR_MAX_TOKENS=2048
# Facteur de rendu des pages envoyées au modèle de vision.
# OPENAI_OCR_RENDER_SCALE=2.0
# Consigne envoyée pour chaque page (défaut : transcription Markdown fidèle).
# OPENAI_OCR_PROMPT=Transcris cette page PDF en Markdown lisible sans résumer ni modifier le contenu.

# ===== 4. DÉCOUPAGE, RECODAGE ET EMBEDDINGS =====

# --- 4.1 Découpage et parallélisme ---
# Threads du chunking et des appels d'API (défaut : nombre de CPU − 1).
# Ne jamais laisser vide (la page /health/detailed lit un entier).
DEFAULT_MAX_WORKERS=8
# Documents traités en parallèle au chunking (défaut : 3).
DEFAULT_DOC_WORKERS=6
# Délai minimal (s) entre deux écritures atomiques du fichier de chunks.
CHUNK_CHECKPOINT_SECONDS=30

# --- 4.2 Recodage ---
# Chunks par lot de recodage GPT.
DEFAULT_BATCH_SIZE_GPT=5
# Durcissement du décodage (température 0, top_p 1, seed, snapshot daté),
# indépendant du cache. Avec 1, RECODE_MODEL remplace le modèle choisi (jusqu'au lot 4).
RECODE_HARDEN_ENABLED=0
# Paramètres du décodage durci.
RECODE_TEMPERATURE=0.0
RECODE_TOP_P=1.0
RECODE_SEED=0
# Borné ; sûr seulement avec la garde finish_reason (fallback_truncated).
RECODE_MAX_TOKENS=1600
# Backend OpenRouter épinglé (allow_fallbacks=False), obligatoire pour cacher
# le chemin OpenRouter.
# RECODE_OPENROUTER_PROVIDER=

# --- 4.3 Caches ---
# Cache SQLite du recodage indexé par content_hash : un succès déjà vu coûte
# 0 appel LLM et redonne un texte identique à l'octet. 0 (défaut) = inchangé.
RECODE_CACHE_ENABLED=0
# Cache des vecteurs denses (texte identique → vecteur gelé).
RECODE_EMBED_CACHE_ENABLED=0
RECODE_CACHE_PATH=data/recode_cache.sqlite

# --- 4.4 Embeddings ---
# Chunks par lot d'embeddings OpenAI.
DEFAULT_EMBEDDING_BATCH_SIZE=32
# Lots d'embeddings en vol par worker (fenêtre bornée).
EMBEDDING_FUTURES_PER_WORKER=4
# Part d'embeddings OpenAI manquants tolérée avant l'échec de la phase dense
# (0 à 1 ; 0 = aucun manque, la phase sort en erreur).
EMBED_MAX_MISSING_RATIO=0
# Textes par requête d'embeddings (plafonné à 64).
ALBERT_EMBED_BATCH=64
# Part d'embeddings manquants tolérée avant l'échec de la phase (0.0 = aucun manque).
ALBERT_EMBED_MAX_MISSING_RATIO=0.0
# 1 = vecteurs normalisés L2 (norme enregistrée dans l'espace vectoriel).
ALBERT_EMBED_L2_NORMALIZE=1

# ===== 5. NOTES, FICHES, CITATIONS ET AUDIO =====

# --- 5.1 Notes et fiches ---
# Appels LLM simultanés sur toute la plateforme (notes, fiches, citations ;
# sémaphore global partagé entre utilisateurs).
MAX_CONCURRENT_LLM_CALLS=5
# Notes de livres en plusieurs phases : v2 (contrôles qualité après
# assemblage) ou v1 (sans ces contrôles).
BOOK_NOTE_VERSION=v2

# --- 5.2 Citations (Publish or Perish) ---
# Import Publish or Perish : pages web récupérées en parallèle et citations par
# lot (1 à 50).
MAX_CONCURRENT_WEB_FETCHES=10
DEFAULT_CITATION_BATCH_SIZE=10

# --- 5.3 Audio (Albert) ---
# Quota et concurrence de la transcription.
ALBERT_AUDIO_RPM=45
ALBERT_AUDIO_CONCURRENCY=1
# Langue (code ISO 639-1 ; auto = détection par le modèle).
ALBERT_AUDIO_LANGUAGE=fr
# Durée des segments découpés par ffmpeg pour les fichiers longs (30 à 3600 s).
ALBERT_AUDIO_SEGMENT_SECONDS=600
# Délai HTTP (s) d'une requête de transcription.
ALBERT_TIMEOUT_AUDIO=300

# ===== 6. DÉDUPLICATION ET BASES VECTORIELLES =====

# --- 6.1 Déduplication des chunks ---
# Interrupteur maître. 0 (défaut) = comportement strictement identique : aucun
# content_hash écrit dans le JSON, id aléatoire conservé, dedup_filter inactif.
DEDUP_ENABLED=0
# Tier 3 sémantique (similarité d'embedding sur les survivants du Tier 2).
# Réservé aux petits lots ré-OCRisés par plusieurs fournisseurs.
DEDUP_SEMANTIC=0
# Seuil du Tier 3 (les métadonnées et le Jaccard portent la décision).
DEDUP_SIM_THRESHOLD=0.97
# Jaccard minimal sur les trigrammes de mots (Tier 3).
DEDUP_TEXT_JACCARD=0.92
# Champs qui identifient la SOURCE d'un chunk (id v2 = contenu + source, audit
# A05) et doivent concorder avant un refus (ex. title,authors). Titres
# génériques (« Introduction ») : ajouter authors ou itemKey, sinon deux œuvres
# homonymes au passage identique partagent un id. Champ vide = jamais dédupliqué.
DEDUP_META_FIELDS=title
# Plancher de texte normalisé ; en deçà, le chunk n'est jamais comparé.
DEDUP_MIN_CHARS=64
# Taille du lot d'existence (1 aller-retour par lot, pas par chunk).
DEDUP_QUERY_BATCH=100
# Témoins existants listés au plus par refus.
DEDUP_MATCH_MAX=3
# Garde : au-delà de ce nombre de survivants, le Tier 3 est sauté.
DEDUP_SEMANTIC_MAX_SURVIVORS=500
# Seuil Tier 3 de la dédup pour bge-m3 ; vide (défaut) = Tier 3 sauté pour bge-m3.
DEDUP_SIM_THRESHOLD_BGE_M3=
# Dossier du journal dedup_journal.jsonl (défaut : à côté du JSON d'embeddings).
# DEDUP_JOURNAL_DIR=

# --- 6.2 Envoi vers Pinecone, Weaviate, Qdrant ---
# Taille des lots d'insertion.
PINECONE_BATCH_SIZE=100
WEAVIATE_BATCH_SIZE=100
QDRANT_BATCH_SIZE=100

# --- 6.3 Collections Albert ---
# Métadonnées envoyées aux collections : 10 au plus, avec content_id, content_hash,
# chunk_index et DEDUP_META_FIELDS ; jamais path.
ALBERT_METADATA_FIELDS=content_id,content_hash,chunk_index,total_chunks,title,authors,year,doi,item_key,filename
# Délai HTTP (s) des appels aux collections.
ALBERT_TIMEOUT_COLLECTIONS=120

# ===== 7. ALBERT : QUOTAS, CONCURRENCE, RÉESSAIS, DÉLAIS ET TRAÇABILITÉ =====

# --- 7.1 Quotas (partagés par compte) ---
# Limiteur proactif, environ 90 % des quotas du régime d'expérimentation : requêtes
# par minute des rôles recodage, notes, OCR et embeddings, puis tokens d'entrée
# estimés par minute pour les rôles de chat.
ALBERT_RECODE_RPM=45
ALBERT_NOTES_RPM=9
ALBERT_OCR_RPM=45
ALBERT_EMBED_RPM=450
ALBERT_CHAT_TPM=115000
# Part des quotas attribuée à ce processus (0 < part <= 1).
ALBERT_PROCESS_SHARE=1.0
# Estimation des tokens d'entrée du limiteur (chars = longueur / 3 ; ou tiktoken).
ALBERT_TOKEN_ESTIMATOR=chars

# --- 7.2 Limiteur ---
# local = limiteur par processus ; redis = partagé (recommandé avec Celery ou
# plusieurs sessions). Laisser en commentaire sous Docker Compose : le défaut y est
# redis (docker-compose.yml), et une valeur écrite ici le remplace. Hors Docker, le
# défaut du code est local.
# ALBERT_LIMITER_BACKEND=local
# URL Redis du limiteur ; vide = CELERY_BROKER_URL, sinon redis://localhost:6379/0.
ALBERT_LIMITER_REDIS_URL=
# 1 = avec ALBERT_LIMITER_BACKEND=redis, aucun nouvel appel si Redis est injoignable
# (au lieu du seau local par processus, qui ne garantit pas le plafond du compte).
ALBERT_LIMITER_REQUIRE_REDIS=0

# --- 7.3 Concurrence ---
# Appels Albert simultanés par processus : recodage, notes et fiches, embeddings,
# envois de chunks vers une collection.
ALBERT_RECODE_CONCURRENCY=2
ALBERT_NOTES_CONCURRENCY=2
ALBERT_EMBED_CONCURRENCY=4
ALBERT_PUSH_CONCURRENCY=1

# --- 7.4 Raisonnement ---
# Effort de raisonnement des modèles gpt-oss (low, medium, high).
ALBERT_REASONING_EFFORT=medium
# Tokens ajoutés à max_tokens pour le raisonnement des modèles gpt-oss.
ALBERT_REASONING_HEADROOM=2048

# --- 7.5 Réessais et délais ---
# Essais courts sur 503 avant le repli de rôle.
ALBERT_BUSY_RETRIES=2
# Réessais au plus sur erreur transitoire ; backoff exponentiel (base et plafond,
# en secondes).
ALBERT_MAX_RETRIES=4
ALBERT_RETRY_BACKOFF=2.0
ALBERT_RETRY_MAX_BACKOFF=60
# Retry-After (secondes) au-delà duquel un 429 signifie un quota épuisé (abandon).
ALBERT_RETRY_AFTER_MAX=120
# Délais HTTP (secondes) : chat, notes et fiches, page OCR, part /v1/ocr,
# embeddings.
ALBERT_TIMEOUT_CHAT=120
ALBERT_TIMEOUT_NOTES=300
ALBERT_TIMEOUT_OCR_PAGE=120
ALBERT_TIMEOUT_OCR_DOC=300
ALBERT_TIMEOUT_EMBED=60
# Délai (secondes) des sous-processus quand la requête sélectionne Albert (6 h) ;
# sinon, délais historiques inchangés.
ALBERT_SUBPROCESS_TIMEOUT=21600

# --- 7.6 Traçabilité ---
# 1 = ledger albert_usage.jsonl écrit quand Albert a été appelé.
ALBERT_USAGE_LOG=1
# 1 = contrôle du compte et des modèles (/v1/me, /v1/models) avant un traitement.
ALBERT_PREFLIGHT=1

# ===== 8. TRAITEMENTS : ADMISSION, IMPORTS ET SESSIONS =====

# --- 8.1 Admission (audit A12) ---
# Traitements actifs sur le serveur et par utilisateur (429 au-delà ; 0 = sans
# limite). Un traitement du même groupe sur une session déjà occupée est
# refusé (409). Verrous partagés entre processus et conteneurs dans
# RAGPY_LOCK_DIR (vide = data/locks).
MAX_ACTIVE_JOBS=8
MAX_ACTIVE_JOBS_PER_USER=3
RAGPY_LOCK_DIR=

# --- 8.2 Imports (audit A01) ---
# Limites (Mo ; 0 = pas de limite) du fichier envoyé et de l'archive ZIP
# décompressée, puis nombre de membres d'une archive (413 au-delà). Aligner
# client_max_body_size dans nginx.
UPLOAD_MAX_MB=4096
UPLOAD_MAX_UNZIPPED_MB=16384
UPLOAD_MAX_ZIP_ENTRIES=100000

# --- 8.3 Sessions et nettoyage ---
# Durée de vie (heures) d'une session de traitement avant suppression de son
# dossier uploads/<session>.
SESSION_TTL_HOURS=24
# Nettoyage périodique des sessions expirées (planificateur de l'application
# web, pas Celery Beat).
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=6

# ===== 9. COMPTES, SÉCURITÉ ET DÉPLOIEMENT =====

# --- 9.1 Environnement et secret JWT (audit A09) ---
# production = démarrage refusé si JWT_SECRET_KEY est absent, vaut la valeur de
# remplacement du dépôt ou fait moins de 32 caractères (development : alerte
# seule dans les journaux).
RAGPY_ENV=development
# Secret JWT, défini une fois : il dérive aussi la clé Fernet des identifiants
# stockés. Vide = valeur de remplacement publique (refusée en production).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Rotation : l'ancien secret ici le temps de rechiffrer
# (scripts/rotate_credentials_key.py), puis vider. Sans lui, changer
# JWT_SECRET_KEY rend illisibles les clés enregistrées par les utilisateurs.
JWT_SECRET_KEY_PREVIOUS=
JWT_ALGORITHM=HS256
# Durée de vie des jetons d'accès (minutes) et de rafraîchissement (jours).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 9.2 Accès web et base de données ---
# Origines cross-origin autorisées (avec cookies), séparées par des virgules ;
# les pages sont servies par l'application elle-même.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# URL publique de l'application (liens des e-mails de vérification et de
# réinitialisation). Ex. https://ragpy.example.org derrière nginx.
APP_URL=http://localhost:8000
# Base SQLite par défaut : data/ragpy.db du dépôt (/app/data sous Docker).
# Ne jamais laisser la ligne vide : la commenter pour garder le défaut.
# DATABASE_URL=sqlite:////app/data/ragpy.db
# true = requêtes SQL tracées dans les journaux.
DEBUG=false

# --- 9.3 Comptes et e-mails ---
# Validité (heures) des liens de vérification et de réinitialisation.
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
# TRUE = toute nouvelle inscription non-admin attend l'approbation d'un
# administrateur (Admin > Utilisateurs). Défaut : FALSE.
USERS_SANDBOX=TRUE

# ===== 10. SERVEUR, CELERY, REDIS, FLOWER ET IMAGE DOCKER =====

# --- 10.1 Serveur Uvicorn (image Docker) ---
# Lu par la commande de démarrage de l'image (en local, passer les options à
# uvicorn). Garder 1 worker : le registre des scripts en cours (bouton Arrêt),
# les flux SSE et le planificateur de nettoyage vivent dans le processus ;
# plusieurs workers les dispersent.
UVICORN_WORKERS=1
# Keep-alive (s), pour les traitements longs.
UVICORN_TIMEOUT_KEEP_ALIVE=120
# Requêtes simultanées au plus par worker.
UVICORN_LIMIT_CONCURRENCY=100

# --- 10.2 Celery et Redis (mode file de tâches) ---
# true = endpoints /api/celery/* actifs (sinon : traitements en sous-processus
# avec progression SSE, mode par défaut).
ENABLE_CELERY=false
# Broker et résultats. Sous Docker Compose, forcés à redis://redis:6379/0
# (réseau interne) quelle que soit la valeur ci-dessous.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Adresse de publication de Redis sur l'hôte (sans mot de passe) : 127.0.0.1 par
# défaut ; 0.0.0.0 seulement derrière un pare-feu.
REDIS_BIND=127.0.0.1
# Âge (s) au-delà duquel un script du worker est tué comme orphelin ; vide =
# plus grande limite de temps d'une tâche (Albert compris) + 600 s.
ORPHAN_PROCESS_MAX_RUNTIME=

# --- 10.3 Flower ---
# Adresse de publication de Flower sur l'hôte : 127.0.0.1 par défaut ; 0.0.0.0
# seulement derrière un pare-feu.
FLOWER_BIND=127.0.0.1
# Obligatoires : Flower refuse de démarrer sans identifiants ou avec admin/admin,
# admin/changeme (audit A09). Accès : tunnel SSH vers le port 5555.
FLOWER_USER=
FLOWER_PASSWORD=

# --- 10.4 Construction de l'image ---
# true = Docling (OCR local) installé dans l'image Docker ; lu à la construction
# (docker compose up -d --build).
INSTALL_LOCAL_OCR=false
# Audio Albert (sprint R2) : true = ffmpeg dans l'image Docker (conversion et
# découpage des enregistrements longs) ; lu à la construction (docker compose up -d --build).
INSTALL_FFMPEG=false

# ===== 11. SUPERVISION (PROMETHEUS, FACULTATIF) =====

# --- 11.1 Métriques ---
# Métriques exposées sur /metrics si prometheus-fastapi-instrumentator est
# installé.
ENABLE_METRICS=true
# Pushgateway des scripts CLI (vide = pas d'envoi) et nom du job.
# PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
METRICS_JOB_NAME=ragpy_cli
# Mot de passe admin de Grafana si le service est décommenté dans
# docker-compose.yml (défaut : admin).
# GRAFANA_PASSWORD=
